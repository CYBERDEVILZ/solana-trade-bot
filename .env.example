# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# === Wallets ===
# Public address of your MAIN Solflare wallet (read-only, for reference)
MAIN_WALLET_PUBKEY=

# Public address of the DEDICATED trading wallet (created in Phase 1)
TRADING_WALLET_PUBKEY=

# Private key of the DEDICATED trading wallet (base58 string from Solflare export)
# This wallet should only ever hold ~5000 INR worth of funds.
TRADING_WALLET_PRIVKEY=

# === Solana RPC ===
# Default is public RPC (rate limited). For production, use Helius or QuickNode.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Risk parameters ===
MAX_CAPITAL_INR=5000
RISK_PER_TRADE_PCT=2.0
MAX_DRAWDOWN_PCT=15.0
DAILY_LOSS_HALT_PCT=5.0

# === Strategy parameters ===
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_MIN=40
RSI_MAX=70
ATR_PERIOD=14
ATR_STOP_MULT=1.5
ATR_TARGET_MULT=3.0
VOL_FILTER_MULT=0.8

# Trading universe — comma-separated symbols. Bot scans these and takes first valid entry.
UNIVERSE=SOL,JTO

# === Operational ===
PAPER_MODE=true
EOD_FLATTEN_HOUR_IST=23
EOD_FLATTEN_MINUTE_IST=55
