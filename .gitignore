# Secrets — NEVER commit
.env
*.key
*.pem
wallet_keypair.json

# Machine-specific scheduler wrapper (paths hard-coded for one host)
run_cycle.bat

# Logs — verbose, regenerated each run
logs/

# State.json is now committed — needed for GitHub Actions to persist across runs
# (each Actions run is ephemeral, so state must live in the repo)
data/fx_cache.json
# Tax/trade logs ARE committed — historical records that matter for tax filing

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# OS
Thumbs.db
.DS_Store
.claude/
